#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 # 为 LuCI 软件包页面提供本地安装包的描述元数据。
 if command -v opkg >/dev/null 2>&1 && [ -f /usr/lib/opkg/info/luci-app-webdavui.control ]; then
  local lists_dir
  lists_dir=$(sed -rne 's#^lists_dir [^ ]+ ([^ ]+).*#\1#p' /etc/opkg.conf /etc/opkg/*.conf 2>/dev/null | tail -n 1)
  lists_dir=${lists_dir:-/usr/lib/opkg/lists}
  mkdir -p "$lists_dir"
  { cat /usr/lib/opkg/info/luci-app-webdavui.control; printf '\n'; } | gzip -c > "$lists_dir/webdavui-local" || true
 fi
 local enabled
 config_load webdavui
 config_get_bool enabled main enabled 0
 [ "$enabled" = 1 ] || return 0
 /usr/libexec/webdavui-config || return 1
 procd_open_instance
 procd_set_param command /usr/sbin/lighttpd -D -f /var/etc/webdavui.conf
 procd_set_param respawn 3600 5 5
 procd_set_param file /etc/config/webdavui /etc/webdavui/users
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
reload_service() {
 local enabled
 config_load webdavui
 config_get_bool enabled main enabled 0
 if [ "$enabled" = 1 ]; then
  /usr/libexec/webdavui-config || return 1
 fi
 stop
 start
}
service_triggers() {
 procd_add_reload_trigger webdavui
}
