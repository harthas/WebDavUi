#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 local enabled
 config_load webdavui
 config_get_bool enabled main enabled 0
 [ "$enabled" = 1 ] || return 0
 /usr/libexec/webdavui-config || return 1
 procd_open_instance
 procd_set_param command /usr/sbin/lighttpd -D -f /var/etc/webdavui.conf
 procd_set_param respawn 3600 5 5
 procd_set_param file /etc/config/webdavui /etc/webdavui/users
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
reload_service() {
 local enabled
 config_load webdavui
 config_get_bool enabled main enabled 0
 if [ "$enabled" = 1 ]; then
  /usr/libexec/webdavui-config || return 1
 fi
 stop
 start
}
service_triggers() {
 procd_add_reload_trigger webdavui
}
