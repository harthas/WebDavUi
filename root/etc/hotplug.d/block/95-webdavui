#!/bin/sh
# 延迟扫描，使自动挂载先完成；仅刷新已经运行的服务。
case "$ACTION" in add|remove|change) ;; *) exit 0;; esac
(
 sleep 4
 [ ! -d /var/lock/webdavui-move.lock ] || exit 0
 ubus call service list '{"name":"webdavui"}' | jsonfilter -e '@.webdavui.instances.*.running' | grep -q true || exit 0
 /etc/init.d/webdavui reload >/tmp/webdavui-rescan.log 2>&1
) </dev/null >/dev/null 2>&1 &
